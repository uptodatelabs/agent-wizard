{
  "name": "agent-wizard",
  "version": "0.1.0",
  "description": "AI coding assistant configuration wizard - Set up your AI tools in minutes, not hours",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "bin": {
    "agent-wizard": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "configuration",
    "wizard",
    "claude",
    "cursor",
    "copilot",
    "aider",
    "openclaw",
    "hermes",
    "cli",
    "developer-tools",
    "productivity"
  ],
  "author": "uptodatelabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uptodatelabs/agent-wizard.git"
  },
  "bugs": {
    "url": "https://github.com/uptodatelabs/agent-wizard/issues"
  },
  "homepage": "https://github.com/uptodatelabs/agent-wizard#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "ink": "^6.5.1",
    "inquirer": "^9.0.0",
    "json5": "^2.2.3",
    "ora": "^5.4.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  }
}
