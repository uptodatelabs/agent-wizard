    "hermes",
    "cli",
    "developer-tools",
    "productivity"
  ],
  "author": "uptodatelabs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/uptodatelabs/agent-wizard.git"
  },
  "bugs": {
    "url": "https://github.com/uptodatelabs/agent-wizard/issues"
  },
  "homepage": "https://github.com/uptodatelabs/agent-wizard#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "ink": "^7.1.1",
    "inquirer": "^9.0.0",
    "ora": "^5.4.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  }
