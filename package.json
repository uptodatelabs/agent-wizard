{
  "name": "agent-wizard",
  "version": "0.1.0",
  "description": "AI coding assistant configuration wizard - Set up your AI tools in minutes, not hours",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-wizard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
